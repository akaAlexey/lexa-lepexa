# Скопируйте в backend/.env для локального запуска. В git не кладите.

# Postgres из backend/docker-compose.yml
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/memory_trail

# Через запятую. Для сайта на GitHub Pages: https://team-shpilit.github.io
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 1 — залить демо-данные фронта в пустую базу при старте
SEED_DEMO=1

# ЮKassa, тестовый магазин. Секретный ключ (test_…) — только в .env на сервере, в git не класть.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Адрес сайта: сюда ЮKassa вернёт пользователя после оплаты
SITE_URL=https://marshrutypobedy.ru

HOST=0.0.0.0
PORT=8000
