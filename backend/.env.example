# Local Docker database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/memory_trail

# For Deploy-F replace DATABASE_URL with the managed PostgreSQL/PostGIS connection string.
# CORS_ORIGINS=https://your-frontend-domain
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Deploy-F may provide PORT automatically.
HOST=0.0.0.0
PORT=8000
