# Скопируйте в .env рядом с docker-compose.yml. Файл .env в git не попадает.

# Пароль базы Postgres — обязательно поменяйте на сервере
POSTGRES_PASSWORD=change-me

# Адрес сайта для Caddy: ":80" — локально без HTTPS; домен (tropa.example.ru) — на сервере с HTTPS
SITE_ADDRESS=:80
# Порты на машине. На сервере с доменом поставьте 80 и 443
HTTP_PORT=8080
HTTPS_PORT=8443

# 1 — залить демо-данные фронта в пустую базу при старте (существующие записи не трогаются)
SEED_DEMO=1
