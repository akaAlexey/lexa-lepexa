# Скопируйте в .env рядом с docker-compose.yml. Файл .env в git не попадает.

# Пароль базы Postgres — обязательно поменяйте на сервере
POSTGRES_PASSWORD=change-me

# Адрес сайта для Caddy: ":80" — локально без HTTPS; домен (tropa.example.ru) — на сервере с HTTPS
SITE_ADDRESS=:80
# Порты на машине. На сервере с доменом поставьте 80 и 443
HTTP_PORT=8080
HTTPS_PORT=8443

# 1 — залить демо-данные фронта в пустую базу при старте (существующие записи не трогаются)
SEED_DEMO=1

# ЮKassa — только тестовый магазин: сервер не создаёт платёж, если ключ не начинается с test_.
# Значения — только в .env (он в .gitignore) или в переменных хостинга. Во фронт и в VITE_* не класть.
# Тестовый магазин, открыто по решению команды (26.09): реальные деньги не участвуют, ключ — только test_.
YOOKASSA_SHOP_ID=1476293
YOOKASSA_SECRET_KEY=test_n1FpeUe_gfwVSGrV1ZMIudDtSsekAwQECR57icQaiJs
# Страница результата оплаты; пусто — http://marshrutypobedy.ru/payment
YOOKASSA_RETURN_URL=
# Тестовый шлюз выплат — на будущее, кодом не используется
YOOKASSA_PAYOUT_AGENT_ID=
YOOKASSA_PAYOUT_SECRET_KEY=
