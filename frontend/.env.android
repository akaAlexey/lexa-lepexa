# Сборка для APK (npm run build:android): приложение работает с тем же сервером и общей базой, что и сайт
# (вход, заявки, истории, семейный архив — одни данные на сайте и в приложении). Без service worker:
# в WebView Capacitor файлы и так лежат локально, а воркер мешал бы локальному серверу.
# Другой сервер — переменная окружения VITE_API_URL при сборке (в CI — vars.API_URL).
VITE_API_MODE=live
VITE_API_URL=https://api.marshrutypobedy.ru/api/v1
VITE_OFFLINE=off
# Сервер не ответил при запуске (нет связи, сервер на обслуживании) — приложение работает на встроенных
# данных и показывает плашку «Сервер недоступен»; при следующем запуске сервер проверяется снова.
VITE_API_FALLBACK=device
VITE_TILES=openfreemap
