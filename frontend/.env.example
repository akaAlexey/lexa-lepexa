# Скопируйте в .env.local. Все VITE_* попадают в бандл — не кладите сюда секреты.
# mock — фикстуры (по умолчанию), live — реальный сервер
VITE_API_MODE=mock
# Базовый URL API для live: HTTPS-адрес сервера или путь на том же домене.
# /api/v1 — локально через прокси Vite на http://127.0.0.1:8000 (другой адрес — VITE_API_PROXY) и в docker compose
# VITE_API_URL=https://example.ru/api/v1
# VITE_API_URL=/api/v1
# openfreemap — векторные тайлы без ключа; none — только бумажный фон и метки
VITE_TILES=openfreemap
VITE_MOCK_LATENCY_MS=300
